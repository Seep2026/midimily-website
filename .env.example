VITE_AI_NAVIGATOR_BASE_URL=
VITE_AI_NAVIGATOR_API_KEY=
VITE_AI_NAVIGATOR_MODEL=glm-5.1

# Appointment email service. Keep these server-only values out of any VITE_ variable.
APPOINTMENT_PORT=8787
APPOINTMENT_HOST=127.0.0.1
APPOINTMENT_ALLOWED_ORIGINS=https://midimily.com
APPOINTMENT_TRUST_PROXY=true
APPOINTMENT_TO=replace-with-primary-recipient@example.com
APPOINTMENT_CC=replace-with-copy-recipient@example.com
APPOINTMENT_FROM="米地咨询 <admin@midimily.com>"
APPOINTMENT_REPLY_TO=admin@midimily.com

# Tencent Cloud SES API mode. Never prefix these values with VITE_.
EMAIL_MODE=tencent-ses
TENCENTCLOUD_SECRET_ID=replace-with-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-secret-key
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_TEMPLATE_ID=212453

# Optional legacy SMTP mode: set EMAIL_MODE=smtp and configure this URL.
SMTP_URL=smtps://username:password@smtp.example.com:465
