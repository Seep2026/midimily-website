{
  "name": "midimily-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "appointments:start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.appointment.local server/appointment-server.mjs",
    "appointments:ses:check": "node --env-file=.env.local --env-file=.env.appointment.local server/tencent-ses-check.mjs",
    "appointments:ses:test": "node --env-file=.env.local --env-file=.env.appointment.local server/tencent-ses-smoke.mjs",
    "appointments:test": "node --test server/appointment.test.mjs src/lib/appointmentRoute.test.mjs",
    "deck:build": "node scripts/build-deck.mjs",
    "deck:build:all": "node scripts/build-all-decks.mjs",
    "deck:publish": "pnpm deck:build:all && pnpm build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "nodemailer": "^9.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tencentcloud-sdk-nodejs-ses": "^4.1.271",
    "tw-animate-css": "^1.3.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@slidev/cli": "^52.15.0",
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.12",
    "vite": "^6.3.5"
  }
}
